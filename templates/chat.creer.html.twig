{% extends "base.html.twig" %}

{% block title %}AgendSup - Nouveau Chat{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            
            <!-- Fenêtre de création style AgendSup -->
            <div class="card border border-dark rounded-5 shadow bg-white p-4">
                
                <div class="text-center mb-4">
                    <!-- Icône en haut -->
                    <div class="bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-plus fa-xl"></i>
                    </div>
                    <h2 class="fw-bold">Nouveau Chat</h2>
                    <p class="text-muted small">Donnez un nom à votre nouvelle discussion</p>
                </div>

                <!-- Formulaire qui pointe vers la méthode enregistrer du contrôleur -->
                <form action="?controleur=chat&methode=enregistrer" method="POST">
                    
                    <div class="mb-4">
                        <label for="nom_chat" class="form-label fw-bold px-2">Nom de la conversation</label>
                        <input type="text" 
                               name="nom_chat" 
                               id="nom_chat" 
                               class="form-control rounded-pill border-dark shadow-sm px-4 py-2" 
                               placeholder="Ex: Projet de groupe, Révisions..." 
                               required 
                               autofocus>
                    </div>

                    <div class="d-grid gap-3">
                        <!-- Bouton Valider -->
                        <button type="submit" class="btn btn-dark rounded-pill py-2 shadow fw-bold">
                            Créer la discussion
                        </button>
                        
                        <!-- Bouton Annuler -->
                        <a href="?controleur=chat&methode=lister" class="btn btn-outline-dark rounded-pill py-2">
                            Annuler
                        </a>
                    </div>

                </form>

            </div>

            <!-- Petit rappel visuel AgendSup -->
            <div class="text-center mt-4">
                <p class="text-muted italic small">AgendSup - Un Agenda Et bien plus que ça</p>
            </div>

        </div>
    </div>
</div>
{% endblock %}