{% extends "base.html.twig" %}

{% block title %}AgendSup - Paramètres de la classe{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="public/assets/css/connected.css">

{% endblock %}

{% block body %}
    <section class="create-class d-flex flex-column align-items-center justify-content-center" style="min-height: 100vh;">
        
        {# --- En-tête des Onglets --- #}
        {# D'après l'image, "Classe" est foncé et "Paramètres" clair/transparent #}
        <div class="d-flex flex-row align-items-end justify-content-center w-50">
            <h3 class="bg-dark text-white border border-black border-bottom-0 rounded-top px-5 py-2 mb-0 text-center w-50" style="opacity: 0.8;">
                Classe
            </h3>
            <h3 class="bg-gray border border-black border-bottom-0 rounded-top px-5 py-2 mb-0 text-center w-50">
                Paramètres
            </h3>
        </div>

        <div class="position-relative section-class bg-gray w-50 d-flex flex-column justify-content-center align-items-center border border-black p-5">
            
            {# 1. Barre de Volume #}
            <div class="volume-bar w-75 p-3 mb-5 d-flex align-items-center justify-content-center rounded shadow-sm border border-black">
                <span class="fs-4 me-2">Volume Sonore : 80</span>
                <div class="volume-cursor"></div>
            </div>

            <div class="settings-card w-75 p-3 mb-4 rounded d-flex justify-content-between align-items-center">
                <span class="fs-4 ps-4">Chat écrit</span>
                <div class="d-flex align-items-center pe-4 toggle-container fs-5">
                    <span class="me-2">Oui</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="chatEcritSwitch" checked>
                    </div>
                    <span class="ms-2">Non</span>
                </div>
            </div>

            <div class="settings-card w-75 p-3 mb-4 rounded d-flex justify-content-between align-items-center">
                <span class="fs-4 ps-4">Chat vocal</span>
                <div class="d-flex align-items-center pe-4 toggle-container fs-5">
                    <span class="me-2">Oui</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="chatVocalSwitch" checked>
                    </div>
                    <span class="ms-2">Non</span>
                </div>
            </div>

            <div class="settings-card w-75 p-3 rounded d-flex justify-content-between align-items-center">
                <span class="fs-4 ps-4">Couleur Tableau</span>
                <div class="d-flex align-items-center pe-4 toggle-container fs-5">
                    <span class="me-2">Noir</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="colorTableauSwitch">
                    </div>
                    <span class="ms-2">Blanc</span>
                </div>
            </div>

        </div>
        <div class="w-50 border border-black border-top-0 d-flex align-items-center justify-content-between p-0">
            <!-- Bouton Créer -->
            <button class="btn btn-light text-btn border border-black shadow py-2 px-4 m-3 flex-grow-1" style="background-color: white;">
                Créer une classe
            </button>
            
            <!-- Bouton Retour -->
            <a href="?action=connected" class="btn btn-light text-btn border border-black shadow py-2 px-4 m-3 flex-grow-1 text-center" style="background-color: white;">
                Retour
            </a>
        </div>

    </section>
{% endblock %}