<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="public/assets/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Love+Ya+Like+A+Sister&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <title>AgendSup - Page d'accueil</title>
</head>
<body>

    <img id="imgBg" src="public/assets/img/background.png" alt="Fond d'AgendSup">
    <div id="container">
        <header class="btn-message"> 
            <button class="btn-all-gray"><i class="fa-solid fa-message"></i></button>
            <div class="header-right">
                <button class="btn-all-gray"><i class="fa-solid fa-user"></i></button>
                <button class="btn-all-gray"><i class="fa-solid fa-house"></i></button>
            </div>
        </header>

        <div class="hero">
            <h1>AgendSup</h1>
            <p>Un Agenda Et bien plus que ça</p>
            <div class="hero-buttons">
                <img src="public/assets/img/agendboyquisait.png" alt="">
                <button class="btn-primary btn-all-gray">Consulter les devoirs</button>
                <button class="btn-secondary btn-all-gray">Rejoindre une classe</button>
                <button class="btn-secondary btn-all-gray">Creer une classe</button>
                <div class="hero-btn-connect">
                    <button class="btn-all-gray">Se connecter</button>
                    <button class="btn-all-gray">Créer un compte</button>
                </div>
            </div>
        </div>
    
    
        
</body>

</html>