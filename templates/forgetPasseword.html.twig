{#
/**
 * @file forgetPasseword.html.twig
 * @brief Page "Mot de passe oublié"
 *
 * @details Cette page est destinée à permettre à un utilisateur
 * de lancer une procédure de récupération de mot de passe.
 *
 * Elle sert de point d'entrée pour la fonctionnalité
 * "mot de passe oublié" et sera complétée par :
 * - un formulaire de saisie d'adresse email
 * - un message de confirmation ou d'erreur
 *
 * Actuellement, la page hérite du layout principal
 * via base.html.twig mais ne contient pas encore
 * de contenu fonctionnel.
 *
 * @section evolution Évolutions prévues
 * - Ajout d'un formulaire de récupération
 * - Envoi d'un email de réinitialisation
 * - Gestion des messages de retour utilisateur
 *
 * @see base.html.twig
 * @see ConnecterController
 * @version 1.0
 */
#}
{% extends "base.html.twig" %}

{% block title %}AgendSup - Mot de passe oublié
{% endblock %}

{% block body %}
    <div class="container">
        <div class="bg-gray position-absolute top-50 start-50 translate-middle hero text-center rounded-5 p-5">
            <h1 class="titre">AgendSup</h1>
            <p class="text-btn mb-5">Mot de passe oublié</p>
            <div class="hero-buttons position-relative d-flex flex-column gap-3 w-90 mx-auto">
                <form class="position-relative w-90 mx-auto" method="post" action="index.php?controleur=connecter&methode=resetPassword">
                    
                    <p class="mb-4 fw-bold fs-5">Entrez votre adresse email pour recevoir un lien de réinitialisation.</p>

                    <input id="email" type="email" name="email" class="w-100 border-black mb-3 rounded-pill fs-20 p-20" placeholder="votre.email@iutbayonne.univ-pau.fr" required>

                    <button type="submit" class="btn btn-light w-100 rounded-pill border-black p-3 text-btn mt-3 fw-bold">
                        Envoyer
                        <i class="fa-solid fa-paper-plane ml-1"></i>
                    </button>

                </form>

                <div class="liens-compte fs-20 d-flex justify-content-center align-items-center mt-3">
                    <a href="?controleur=connecter&methode=connexion" class="text-decoration-underline fw-bold text-dark">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}