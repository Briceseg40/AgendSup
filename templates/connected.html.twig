{% extends "base.html.twig" %}

{% block title %}AgendSup - Page de connexion
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="public/assets/css/connected.css">
{% endblock %}

{% block body %}
	<div class="container">
		<div class="position-absolute top-50 start-50 translate-middle hero text-center rounded-5 p-5">
			<h1>AgendSup</h1>
			<p class="text-btn">Un Agenda Et bien plus que ça</p>
			<div class="hero-buttons d-flex flex-column gap-3 position-relative">
			    <img id="agendboyquisait" src="public/assets/img/agendboyquisait.png" alt="">
				<a href="?action=agenda" class="text-btn btn btn-light w-100 rounded-3 shadow border-black p-3">Consulter l'agenda</a>
				<a href="?action=join_class" class="text-btn btn btn-light w-100 rounded-3 shadow border-black p-3">Rejoindre une classe</a>
				<button class="text-btn btn btn-light w-100 rounded-3 shadow border-black p-3">Creer une classe</button>
			</div>
			<button class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-3 mt-5 w-auto">Se déconnecter</button>

		</div>
	</div>
{% endblock %}
