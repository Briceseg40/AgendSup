{#
/**
 * @file connected.html.twig
 * @brief Page d'accueil après connexion de l'utilisateur
 *
 * @details Cette page est affichée après la connexion réussie d'un utilisateur.
 * Elle permet d'accéder aux principales fonctionnalités de l'application AgendSup.
 *
 * Fonctionnalités accessibles :
 * - Consultation de l'agenda
 * - Rejoindre une classe
 * - Créer une classe
 * - Se déconnecter de l'application
 *
 * Cette page hérite du template de base `base.html.twig`
 * et affiche un menu central avec des boutons de navigation.
 *
 * @see base.html.twig
 * @version 1.0
 */
#}

{% extends "base.html.twig" %}

{% block title %}AgendSup - Page d'inscription{% endblock %}

{% block body %}
    <div class="container">
        <div class="position-absolute  top-50 start-50 translate-middle hero text-center rounded-5 p-5">
            <h1>AgendSup</h1>
            <p class="text-btn">Un Agenda Et bien plus que ça</p>
            <div class="hero-buttons d-flex flex-column gap-3 position-relative align-items-center">
                <img id="agendboyquisait" src="public/assets/img/agendboyquisait.png" alt="">
				<a href="?controleur=devoir&methode=afficher" class="text-btn btn w-100 rounded-3 shadow border-black p-3 fw-bold">Consulter l'agenda</a>
				<a href="?controleur=joinClass&methode=render" class="text-btn btn w-100 rounded-3 shadow border-black p-3 fw-bold">Rejoindre une classe</a>
				<a href="?controleur=paramclasse&methode=render" class="text-btn btn w-100 rounded-3 shadow border-black p-3 fw-bold">Creer une classe</a>
                <a href="?controleur=connecter&methode=deconnexion" class="text-btn btn rounded-3 shadow border-black p-3 mt-2 fw-bold">Se Déconnecter</a>
            </div>
{% endblock %}
