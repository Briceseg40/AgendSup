{% extends "base.html.twig" %}

{% block title %}AgendSup - Page d'inscription{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="public/assets/css/connected.css">
{% endblock %}

{% block body %}
    <div class="container">
        <div class="position-absolute top-50 start-50 translate-middle hero text-center rounded-5 p-5">
            <h1>AgendSup</h1>
            <p class="text-btn">Un Agenda Et bien plus que ça</p>
            <div class="hero-buttons d-flex flex-column gap-3 position-relative">
                <img id="agendboyquisait" src="public/assets/img/agendboyquisait.png" alt="">
				<a href="?controleur=devoir&methode=afficher" class="text-btn btn btn-light w-100 rounded-3 shadow border-black p-3">Consulter l'agenda</a>
				<a href="?controleur=joinClass&methode=render" class="text-btn btn btn-light w-100 rounded-3 shadow border-black p-3">Rejoindre une classe</a>
				<a href="?controleur=paramclasse&methode=render" class="text-btn btn btn-light w-100 rounded-3 shadow border-black p-3">Creer une classe</a>
            </div>
{% endblock %}
