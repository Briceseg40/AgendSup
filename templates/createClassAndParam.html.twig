{#
/**
 * @file createClassAndParam.html.twig
 * @brief Page de création et de paramétrage d'une classe
 *
 * @details Cette page permet à un utilisateur de créer une nouvelle classe
 * dans l'application AgendSup.
 *
 * Elle est composée de deux onglets :
 * - Classe : saisie du nom, du code et de l'image associée à la classe
 * - Paramètres : configuration du volume sonore, du chat écrit et vocal,
 *   ainsi que la description de la classe
 *
 * Le formulaire est envoyé en POST vers le contrôleur ParamClasse
 * pour enregistrer la nouvelle classe.
 *
 * @section features Fonctionnalités
 * - Création d'une classe
 * - Choix d'une image représentative
 * - Paramétrage des options de communication
 * - Validation et envoi du formulaire
 *
 * @section javascript Scripts JavaScript
 * - Gestion dynamique du volume sonore
 * - Sélection interactive de l'image de la classe
 *
 * @see base.html.twig
 * @see ParamClasseController
 * @author Groupe AgendSup
 * @version 1.0
 */
#}

{% extends "base.html.twig" %}

{% block title %}AgendSup - Créer une classe
{% endblock %}

{% block body %}
	<div class="container d-flex flex-column align-items-center justify-content-center mt-5">

		<form method="post" action="?controleur=paramClasse&methode=creer" class="w-75">

			<ul class="nav nav-tabs border-0 justify-content-center" id="myTab" role="tablist">
				<li class="nav-item" role="presentation">
					<button class="nav-link active btn-tab fs-20" id="classe-tab" data-bs-toggle="tab" data-bs-target="#classe-pane" type="button" role="tab">
						Classe
					</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link btn-tab fs-20" id="params-tab" data-bs-toggle="tab" data-bs-target="#params-pane" type="button" role="tab">
						Paramètres
					</button>
				</li>
			</ul>

			<div class="section-class bg-gray p-2">

				<div class="tab-content" id="myTabContent">

					<div class="tab-pane fade show active" id="classe-pane" role="tabpanel" tabindex="0">

						<div class="d-flex gap-1 flex-column">
							<div class="mb-3 text-start">
								<label class="fs-4 mb-2">Nom de la classe</label>
								<input type="text" name="nom" class="form-control border-black shadow-sm p-2 fs-5" placeholder="Nouvelle classe" required>
							</div>

							<div class="mb-3 text-start">
								<label class="fs-4 mb-2">Code de la classe</label>
								<input type="text" name="code" class="form-control border-black shadow-sm p-2 fs-5" placeholder="Code classe" required>
								{% if error %}
    <p class="text-danger fw-bold d-block">
        {{ error }}
    </p>
{% endif %}
							</div>

							<div class="mb-4 text-start">
								<label class="fs-4 mb-2">Choisissez une image</label>
								<input type="hidden" name="image" id="selectedImageInput" value="agendboyquisait.png">

								<div class="d-flex gap-3 overflow-auto custom-scroll p-2 pb-3">

									<div class="image-option-container selected position-relative" onclick="selectImage('agendboyquisait.png', this)">
										<img src="public/assets/img/agendboyquisait.png" alt="Choix 1" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('agendboyvertstylo.png', this)">
										<img src="public/assets/img/agendboyvertstylo.png" alt="Choix 2" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('bleuquilit.png', this)">
										<img src="public/assets/img/bleuquilit.png" alt="Choix 3" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('4agendboy1.png', this)">
										<img src="public/assets/img/4agendboy1.png" alt="Choix 4" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('4agendboy2.png', this)">
										<img src="public/assets/img/4agendboy2.png" alt="Choix 5" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('4agendboy3.png', this)">
										<img src="public/assets/img/4agendboy3.png" alt="Choix 6" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('4agendboy4.png', this)">
										<img src="public/assets/img/4agendboy4.png" alt="Choix 7" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('agendboyblanclunettestylo.png', this)">
										<img src="public/assets/img/agendboyblanclunettestylo.png" alt="Choix 8" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('agendboyjaunecasquette.png', this)">
										<img src="public/assets/img/agendboyjaunecasquette.png" alt="Choix 9" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('agendboyjauneskate.png', this)">
										<img src="public/assets/img/agendboyjauneskate.png" alt="Choix 10" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('agendboybleulonguevue.png', this)">
										<img src="public/assets/img/agendboybleulonguevue.png" alt="Choix 12" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('agendboyviolethautparleurs.png', this)">
										<img src="public/assets/img/agendboyviolethautparleurs.png" alt="Choix 13" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('pompierRouge.png', this)">
										<img src="public/assets/img/pompierRouge.png" alt="Choix 13" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

									<div class="image-option-container position-relative" onclick="selectImage('medecin.png', this)">
										<img src="public/assets/img/medecin.png" alt="Choix 13" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>
									<div class="image-option-container position-relative" onclick="selectImage('pompier.png', this)">
										<img src="public/assets/img/pompier.png" alt="Choix 13" class="img-thumbnail">
										<div class="check-badge">
											<i class="fa-solid fa-check"></i>
										</div>
									</div>

								</div>
								<div class="mb-3 text-start">
							</div>
							<label class="fs-4 mb-2">Description de la classe</label>
							<input type="text" name="description" class="form-control border-black shadow-sm p-2 fs-5" placeholder="Classe preparatoire de math">
							</div>


							<img src="public/assets/img/agendboyvertstylo.png" alt="" class="position-absolute" style="top: -50px; right: -20px; width: 80px;">
						</div>

					</div>

					<div class="tab-pane fade" id="params-pane" role="tabpanel" tabindex="0">

						<div class="mb-5 w-100">
							<div class="volume-container">
								<div class="volume-text">
									Volume Sonore :
									<span id="volumeValue">80</span>
								</div>
								<input type="range" class="full-height-range" id="volumeRange" min="0" max="100" value="80" name="volume">
							</div>
						</div>

						<div class="settings-card w-100 p-3 mb-4 rounded d-flex justify-content-between align-items-center border border-black bg-white">
							<span class="fs-4 ps-4">Chat écrit</span>
							<div class="d-flex align-items-center pe-4 toggle-container fs-5">
								<span class="me-2">Oui</span>
								<div class="form-check form-switch mb-0">
									<input class="form-check-input" type="checkbox" checked>
								</div>
								<span class="ms-2">Non</span>
							</div>
						</div>

						<div class="settings-card w-100 p-3 mb-4 rounded d-flex justify-content-between align-items-center border border-black bg-white">
							<span class="fs-4 ps-4">Chat vocal</span>
							<div class="d-flex align-items-center pe-4 toggle-container fs-5">
								<span class="me-2">Oui</span>
								<div class="form-check form-switch mb-0">
									<input class="form-check-input" type="checkbox" checked>
								</div>
								<span class="ms-2">Non</span>
							</div>
						</div>

						

					</div>

				</div>
			</div>

			<div class="d-flex justify-content-around align-items-center mt-4 w-100 px-5">
				<a href="?controleur=joinClass&methode=render" class="btn btn-light border border-black shadow fs-4 px-4 py-2 rounded-3 bg-white w-40 fw-bold">
					Retour
				</a>
				<button type="submit" class="btn btn-light border border-black shadow fs-4 px-4 py-2 rounded-3 bg-white w-40 fw-bold">
					Créer une classe
				</button>
			</div>

		</form>
	</div>

	<script>
		const rangeInput = document.getElementById('volumeRange');
const rangeValue = document.getElementById('volumeValue');
if (rangeInput) {
rangeInput.addEventListener('input', function () {
rangeValue.textContent = rangeInput.value;
});
}

function selectImage(filename, elementDiv) {
document.getElementById('selectedImageInput').value = filename;
document.querySelectorAll('.image-option-container').forEach(div => {
div.classList.remove('selected');
});
elementDiv.classList.add('selected');
}
	</script>
{% endblock %}

