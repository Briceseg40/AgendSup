{#
/**
 * @file createClassAndParam.html.twig
 * @brief Page de création et de paramétrage d'une classe.
 *
 * Cette vue permet à l'utilisateur :
 * - de créer une nouvelle classe
 * - de configurer les paramètres associés à la classe
 *
 * L'interface est divisée en deux parties :
 * - section "Classe"
 * - section "Paramètres"
 *
 * Elle hérite du template principal `base.html.twig`
 * et surcharge les blocs `title`, `stylesheets` et `body`.
 */
#}
{% extends "base.html.twig" %}

{% block title %}AgendSup - Page de connexion
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="public/assets/css/connected.css">
{% endblock %}

{% block body %}
	<section class="create-class">
	<div class="d-flex flex-rox align-items-center justify-content-center mb-0">
	<h3 class="bg-gray mt-5 px-5 text-center mb-0 border-botom border-gray border-1">Classe</h3>
	<h3 class="bg-gray mt-5 px-5 text-center mb-0">Paramètres</h3>
	</div>
	<div class="position-relative section-class bg-gray w-100 d-flex flex-column justify-content-center border-black border-1 align-items-center border p-5">
		

	</div>


</div>
	<div class="bg-gray w-100 d-flex flex-rox align-items-center justify-content-around w-25 border-black border-1 border p-2 ">
		<button class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-1 mt-4 w-auto">Créer une classe</button>
		<a href="?action=connected" class="btn text-btn btn-light w-110px rounded-3 shadow border-black p-1 mt-4 ">Retour</a>
	</div>
</section>

	


{% endblock %}