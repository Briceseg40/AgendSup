{#
/**
 * @file login.html.twig
 * @brief Page d'authentification de l'application AgendSup.
 *
 * @details Cette page constitue le point d'entrée principal pour les utilisateurs.
 * Elle permet la saisie des identifiants (email institutionnel et mot de passe)
 * pour accéder aux services de l'agenda.
 *
 * Fonctionnalités :
 * - Formulaire de connexion sécurisé avec méthode POST.
 * - Affichage dynamique des messages d'erreur (identifiants incorrects, etc.).
 * - Liens vers la récupération de mot de passe et la création de compte.
 * - Design personnalisé avec arrière-plan thématique et polices Google Fonts.
 *
 * Technologies utilisées :
 * - HTML5 / CSS3 (login.css, style.css)
 * - Bootstrap 5.3.2
 * - FontAwesome 6.5.1 (Icônes)
 * - Google Fonts (Love Ya Like A Sister)
 *
 * @see connecterController::connexion()
 * @see forgetpassewordController
 * @see registerController
 * @version 1.0
 */
#}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="public/assets/css/style.css">
    <link rel="stylesheet" href="public/assets/css/login.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="public/assets/img/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Love+Ya+Like+A+Sister&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <title>AgendSup page de connexion</title>
</head>
<body>
    <img id="imgBg" src="public/assets/img/background.png" alt="Fond d'AgendSup">
    <header class="btn-message">
    </header>

    <main>
        <div class="container">
		<div class="bg-gray position-absolute top-50 start-50 translate-middle hero text-center rounded-5 p-5">
			<h1 class="titre">AgendSup</h1>
			<p class="text-btn mb-5" >veuillez vous connecter</p>

			 {% if erreur %}
				<div class="alert alert-danger">{{ erreur }}</div>
			{% endif %}

			<div
				class="hero-buttons position-relative d-flex flex-column gap-3 w-90 mx-auto">
				{# <img src="public/assets/img/agendboyquisait.png" alt=""> #}
				<form class="position-relative w-90 mx-auto" method="post" accept-charset="UTF-8" action="index.php?controleur=connecter&methode=connexion">
					<input type="hidden" name="action" value="users/login">

					<input id="loginName" type="text" name="loginName" class="w-100 border-black mb-3 rounded-pill fs-20 p-20" placeholder="votrnom@iutbayonne.univ-pau.fr">

					<input id="password" type="password" name="password" class="w-100 border-black mb-3 rounded-pill fs-20 p-20" placeholder="votremotdepasse">

					<button type="submit" class="btn btn-light w-100 rounded-pill border-black p-3 text-btn">Se connecter
						<i class="fa-solid fa-right-from-bracket ml-1"></i>
					</button>
					{# <button class="btn btn-light w-100 border-black" type="submit" onclick="BtnConnect()">Se connecter</button> #}
				</form>
				<div class="liens-compte fs-20 d-flex justify-content-around align-items-center">
					<a href="?controleur=forgetpasseword&methode=render" class="text-decoration-underline fw-bold ">Mot de passe oublié ?</a>
					<span class="fs-50">•</span>
					<a href="?controleur=register&methode=render" class="text-decoration-underline fw-bold ">Créer un compte</a>
				</div>
			</div>
		</div>
	</div>

    </main>


    <script src="public/assets/js/login.js"></script>
</body>
	