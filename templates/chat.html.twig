{% extends "base.html.twig" %}

{% block body %}
<div class="container mt-5 pt-5">
    <div class="row g-0 border border-2 border-black rounded-5 shadow-lg bg-white overflow-hidden" style="height: 80vh;">
        
        <!-- SIDEBAR GAUCHE : Liste des discussions -->
        <div class="col-4 d-flex flex-column border-end border-2 border-black h-100 bg-white">
            <div class="p-3 border-bottom border-black d-flex justify-content-between align-items-center bg-light">
                <h5 class="fw-bold mb-0 font-love">Messages</h5>
                <!-- Bouton qui ouvre la modale de création -->
                <button type="button" class="btn btn-sm rounded-circle shadow border-2 border-black btn-normal" data-bs-toggle="modal" data-bs-target="#modalNouveauChat">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
            
            <div class="overflow-auto flex-grow-1 list-group list-group-flush">
                {% for chat in chats %}
                    <a href="?controleur=chat&methode=lister&id_chat={{ chat.id }}" 
                       class="list-group-item list-group-item-action p-3 border-bottom border-black {{ idActive == chat.id ? 'bg-gray active' : '' }}">
                        <div class="d-flex align-items-center">
                            <div class="bg-dark text-white rounded-circle me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 45px; height: 45px; min-width: 45px;">
                                <span class="fw-bold">{{ chat.nom|slice(0, 1)|upper }}</span>
                            </div>
                            <div class="text-nowrap overflow-hidden">
                                <div class="fw-bold text-truncate font-love">{{ chat.nom }}</div>
                                <small class="text-muted text-truncate d-block">Cliquer pour discuter</small>
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="p-5 text-center text-muted font-love">Aucun chat.</div>
                {% endfor %}
            </div>
        </div>

        <!-- ZONE DE DROITE : MESSAGES -->
        <div class="col-8 d-flex flex-column h-100 bg-gray">
            {% if activeChat %}
                <div class="p-3 border-bottom border-black d-flex align-items-center justify-content-between bg-white shadow-sm">
                    <div class="d-flex align-items-center">
                        <div class="bg-dark text-white rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                            <small>{{ activeChat.nom|slice(0, 1)|upper }}</small>
                        </div>
                        <h6 class="fw-bold mb-0 font-love">{{ activeChat.nom }}</h6>
                    </div>
                    <!-- Menu options : Poubelle -->
                    <button type="button" 
                            class="btn btn-sm btn-outline-danger border-0 rounded-circle" 
                            onclick="openDeleteChatModal({{ activeChat.id }})">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                    </div>

                <div class="p-4 flex-grow-1 overflow-auto d-flex flex-column gap-3" id="chat-window">
                    {% for msg in messages %}
                        <div class="p-3 shadow-sm border border-black 
                            {{ msg.est_moi ? 'bg-dark text-white align-self-end rounded-4 rounded-bottom-0' : 'bg-white text-dark align-self-start rounded-4 rounded-bottom-0' }}" 
                            style="max-width: 75%;">
                            {{ msg.contenu }}
                        </div>
                    {% endfor %}
                </div>

                <div class="p-3 border-top border-black bg-white">
                    <form action="?controleur=chat&methode=envoyer" method="POST" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="id_chat" value="{{ idActive }}">
                        <input type="text" name="message" class="form-control rounded-pill border-black px-4 py-2" placeholder="Écrivez votre message..." required autocomplete="off">
                        <button type="submit" class="btn rounded-circle shadow btn-normal border border-black shadow rounded-3 bg-white fw-bold" style="width: 45px; height: 45px;"><i class="fa-solid fa-paper-plane"></i></button>
                    </form>
                </div>
            {% else %}
                <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center p-5">
                    <div class="p-4 border border-2 border-black rounded-circle mb-3 bg-white shadow"><i class="fa-solid fa-paper-plane fa-3x text-dark"></i></div>
                    <h4 class="fw-bold font-love">Vos messages</h4>
                    <p class="text-muted">Sélectionnez une discussion ou créez-en une nouvelle.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{# --- MODALE DE CRÉATION (Placée ici car spécifique à cette page) --- #}
<div class="modal fade" id="modalNouveauChat" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-gray border border-2 border-black rounded-4 shadow-lg p-0 overflow-hidden">
            <div class="modal-header border-bottom border-black bg-white p-3">
                <h3 class="modal-title w-100 text-center font-love fw-bold">Nouveau Groupe</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="?controleur=chat&methode=enregistrer" method="POST">
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <label class="text-muted small fst-italic font-love mb-1 px-2">Nom de la discussion</label>
                        <input type="text" name="nom_chat" class="form-control border border-black rounded-pill p-2 px-3 shadow-sm" placeholder="Ex: Projet Web..." required>
                    </div>
                    
                    <label class="text-muted small fst-italic font-love mb-2 px-2">Rechercher des membres</label>
                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-white border border-black border-end-0 rounded-start-pill"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="searchMemberInput" class="form-control border border-black border-start-0 rounded-end-pill p-2" placeholder="Nom ou prénom...">
                    </div>

                    <div class="bg-white border border-black rounded-3 shadow-sm overflow-auto" style="max-height: 250px;">
                        {% for e in etudiants %}
                            <label class="list-group-item d-flex align-items-center p-3 border-bottom border-secondary-subtle member-item">
                                <input class="form-check-input me-3 border-black" type="checkbox" name="participants[]" value="{{ e.id }}">
                                <div class="fw-bold member-name">{{ e.prenom }} {{ e.nom|upper }}</div>
                            </label>
                        {% endfor %}
                    </div>
                </div>
                <div class="modal-footer border-top border-black bg-white justify-content-center p-3">
                    <button type="submit" class="btn-normal btn btn-light border border-black shadow fs-5 px-4 py-2 rounded-3 bg-white w-40 fw-bold">Lancer le chat</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Modal Suppression Chat -->
<div class="modal fade" id="deleteChatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-gray border border-2 border-black rounded-4 shadow-lg p-0 overflow-hidden">
            
            <div class="modal-body text-center pt-4 pb-3">
                <div class="mb-3">
                    <i class="fa-solid fa-trash-can text-danger" style="font-size: 3rem;"></i>
                </div>
                <h3 class="fw-bold mb-3 font-love">Supprimer la discussion ?</h3>
                <p class="text-muted mb-0 px-4">
                    Cette action est irréversible. Tous les messages de ce groupe seront définitivement supprimés pour tous les participants.
                </p>
            </div>

            <div class="modal-footer border-top border-black bg-white justify-content-center gap-3 p-3">
                <button type="button" class="btn btn-light border border-black shadow font-love px-4 py-2 rounded-3 fw-bold" data-bs-dismiss="modal">
                    ANNULER
                </button>
                <a href="#" id="confirmDeleteChatBtn" class="btn btn-danger border border-black shadow font-love px-4 py-2 rounded-3 fw-bold">
                    OUI, SUPPRIMER
                </a>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchMemberInput');
        
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                // 1. On récupère ce que l'utilisateur tape (en minuscule et sans espaces inutiles)
                const searchTerm = this.value.toLowerCase().trim();
                
                // 2. On récupère toutes les lignes de la liste
                const memberItems = document.querySelectorAll('.member-item');

                memberItems.forEach(item => {
                    // 3. On récupère le nom à l'intérieur de cette ligne
                    const nameElement = item.querySelector('.member-name');
                    
                    if (nameElement) {
                        const nameText = nameElement.textContent.toLowerCase();
                        
                        // 4. Si le nom contient le texte recherché
                        if (nameText.includes(searchTerm)) {
                            // On affiche : on retire 'd-none' et on remet 'd-flex'
                            item.classList.remove('d-none');
                            item.classList.add('d-flex');
                        } else {
                            // On cache : on retire 'd-flex' et on ajoute 'd-none'
                            item.classList.add('d-none');
                            item.classList.remove('d-flex');
                        }
                    }
                });
            });
        }
    });

    function openDeleteChatModal(chatId) {
    // On met à jour le lien du bouton de confirmation avec l'ID du chat actuel
    const deleteBtn = document.getElementById('confirmDeleteChatBtn');
    deleteBtn.href = "?controleur=chat&methode=supprimer&id=" + chatId;
    
    // On affiche la modale
    const modal = new bootstrap.Modal(document.getElementById('deleteChatModal'));
    modal.show();
}
</script>
{% endblock %}