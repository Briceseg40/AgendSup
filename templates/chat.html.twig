{% extends "base.html.twig" %}

{% block body %}
<div class="container py-4">
    <!-- Fenêtre principale : Hauteur fixée à 80% de l'écran, coins très arrondis, bordure noire -->
    <div class="row g-0 border border-dark rounded-5 shadow bg-white overflow-hidden" style="height: 80vh;">
        
        <!-- SIDEBAR GAUCHE -->
        <div class="col-4 d-flex flex-column border-end border-dark h-100 bg-white">
            <!-- Header Sidebar avec bouton Nouveau Chat -->
            <button type="button" class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center shadow" 
                    style="width: 35px; height: 35px;" data-bs-toggle="modal" data-bs-target="#modalNouveauChat">
                <i class="fa-solid fa-plus"></i>
            </button>
            
            <!-- Liste des conversations (Scrollable) -->
            <div class="overflow-auto flex-grow-1 list-group list-group-flush">
                {% for chat in chats %}
                    <a href="?controleur=chat&methode=lister&id_chat={{ chat.id }}" 
                       class="list-group-item list-group-item-action d-flex align-items-center p-3 border-bottom border-dark {{ idActive == chat.id ? 'bg-light active text-dark' : '' }}"
                       style="border: 0;">
                        <!-- Avatar : Initiale du nom -->
                        <div class="bg-dark text-white rounded-circle me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 45px; height: 45px; min-width: 45px;">
                            <span class="fw-bold">{{ chat.nom|slice(0, 1)|upper }}</span>
                        </div>
                        <div class="text-nowrap overflow-hidden">
                            <div class="fw-bold text-truncate">{{ chat.nom }}</div>
                            <small class="text-muted text-truncate d-block">Cliquer pour discuter</small>
                        </div>
                    </a>
                {% else %}
                    <div class="p-5 text-center text-muted">
                        <i class="fa-solid fa-ghost fa-2x mb-2"></i>
                        <p class="small">Aucun chat</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- ZONE DE DROITE : MESSAGES -->
        <div class="col-8 d-flex flex-column h-100">
            {% if activeChat %}
                <!-- Header discussion -->
                <div class="p-3 border-bottom border-dark d-flex align-items-center justify-content-between bg-white shadow-sm">
                    <div class="d-flex align-items-center">
                        <div class="bg-dark text-white rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                            <small>{{ activeChat.nom|slice(0, 1)|upper }}</small>
                        </div>
                        <h6 class="fw-bold mb-0">{{ activeChat.nom }}</h6>
                    </div>
                    <!-- Menu options -->
                    <a href="?controleur=chat&methode=supprimer&id={{ activeChat.id }}" class="btn btn-sm btn-outline-danger border-0 rounded-circle">
                        <i class="fa-solid fa-trash"></i>
                    </a>
                </div>

                <!-- Fenêtre de messages (Fond gris clair Bootstrap) -->
                <div class="p-4 flex-grow-1 overflow-auto bg-light d-flex flex-column gap-3" id="chat-window">
                    {% for msg in messages %}
                        <!-- Bulles avec arrondis différenciés (Bootstrap 5.3+ classes) -->
                        <div class="p-3 shadow-sm border border-dark 
                            {{ msg.est_moi ? 
                                'bg-dark text-white align-self-end rounded-4 rounded-bottom-0' : 
                                'bg-white text-dark align-self-start rounded-4 rounded-bottom-0' 
                            }}" style="max-width: 75%;">
                            {{ msg.contenu }}
                        </div>
                    {% endfor %}
                </div>

                <!-- Formulaire d'envoi -->
                <div class="p-3 border-top border-dark bg-white">
                    <form action="?controleur=chat&methode=envoyer" method="POST" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="id_chat" value="{{ idActive }}">
                        
                        <!-- Champ texte Style AgendSup (Pill, Border Dark) -->
                        <input type="text" name="message" class="form-control rounded-pill border-dark shadow-sm px-4 py-2" placeholder="Écrivez votre message..." required autocomplete="off">
                        
                        <!-- Bouton envoyer (Cercle noir) -->
                        <button type="submit" class="btn btn-dark rounded-circle shadow d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; min-width: 45px;">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            {% else %}
                <!-- Écran vide (Center) -->
                <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted text-center p-5">
                    <div class="p-4 border border-dark rounded-circle mb-3 bg-white shadow-sm">
                        <i class="fa-solid fa-paper-plane fa-3x text-dark"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Vos messages</h4>
                    <p>Sélectionnez un camarade pour démarrer une discussion ou créez un nouveau groupe.</p>
                    <a href="?controleur=chat&methode=creer" class="btn btn-dark rounded-pill px-4 shadow-sm fw-bold">
                        Démarrer une discussion
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
<!-- INSERTION DE LA MODALE ICI -->
<div class="modal fade" id="modalNouveauChat" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="?controleur=chat&methode=enregistrer" method="POST" class="modal-content rounded-5 border-dark shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold px-2">Nouveau Chat</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" name="nom_chat" class="form-control rounded-pill border-dark mb-3 px-3" placeholder="Nom du groupe..." required>
                
                <label class="small fw-bold mb-2 px-2 text-muted text-uppercase">Participants</label>
                <div class="list-group border-dark rounded-4 overflow-auto shadow-sm" style="max-height: 200px;">
                    {% for e in etudiants %}
                        <label class="list-group-item d-flex align-items-center border-0 border-bottom p-2 px-3">
                            <input class="form-check-input me-3 border-dark" type="checkbox" name="participants[]" value="{{ e.id }}">
                            <span class="small fw-bold">{{ e.prenom }} {{ e.nom }}</span>
                        </label>
                    {% else %}
                        <div class="p-3 text-center small text-muted">Aucun étudiant trouvé</div>
                    {% endfor %}
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="submit" class="btn btn-dark w-100 rounded-pill py-2 fw-bold">CRÉER LA DISCUSSION</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Scroll auto vers le bas
    var chatWindow = document.getElementById("chat-window");
    if (chatWindow) {
        chatWindow.scrollTop = chatWindow.scrollHeight;
    }
</script>
{% endblock %}