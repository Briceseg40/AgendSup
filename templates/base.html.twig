{#
/**
 * @file base.html.twig
 * @brief Template principal de l'application AgendSup
 *
 * @details Ce fichier définit la structure HTML commune à toutes les pages
 * de l'application AgendSup.
 *
 * Il contient :
 * - l'en-tête HTML (head)
 * - l'import des feuilles de style CSS
 * - l'import des librairies externes (Bootstrap, FullCalendar, FontAwesome)
 * - un header commun avec les boutons de navigation
 * - les blocs Twig extensibles par les autres pages
 *
 * @section twig_blocks Sections Twig
 *
 * @subsection block_title Bloc title
 * Permet aux pages filles de définir le titre de la page.
 *
 * @subsection block_body Bloc body
 * Contient le contenu principal spécifique à chaque page.
 *
 * @section libraries Librairies utilisées
 * - Bootstrap 5
 * - FullCalendar
 * - FontAwesome
 * - Google Fonts
 *
 * @version 1.0
 */
#}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="public/assets/css/style.css">
    <link rel="stylesheet" href="public/assets/css/login.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="public/assets/img/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Love+Ya+Like+A+Sister&display=swap" rel="stylesheet"><!--Love+Ya+Like+A+Sister-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <title>{% block title %}AgendSup{% endblock %}</title>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js'></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    
</head>
<body>

    <img id="imgBg" src="public/assets/img/background.png" alt="Fond d'AgendSup">
    <header class="btn-message w-100 d-flex justify-content-between align-items-center mb-2">
    <a href="?controleur=chat&methode=lister" 
       class="btn border border btn-light rounded-pill shadow-sm px-4 position-relative">
        <i class="fa-solid fa-comments me-2"></i> Messages
        {% if unreadCount is defined and unreadCount > 0 %}
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light shadow-sm" 
                  style="font-size: 0.7rem; padding: 0.4em 0.6em;">
                {{ unreadCount > 99 ? '99+' : unreadCount }}
                <span class="visually-hidden">messages non lus</span>
            </span>
        {% endif %}
        
    </a>
        <div class="header-right">
        <button type="button" class="w-auto btn btn-normal p-2 border btn-light rounded-circle" data-bs-toggle="modal" data-bs-target="#profilModal">
            <i class="fa-solid fa-user"></i>
        </button>
        <a href="?controleur=connecter&methode=render">
            <button class="w-auto btn btn-normal p-2 border btn-light rounded-circle">
                <i class="fa-solid fa-house"></i>
            </button>
        </a>
        </div>
    </header >

    <main>
        {% block body %}{% endblock %}
    </main>
    {% include 'profil-modal.html.twig' %}
</html>