{#
/**
 * @file base.html.twig
 * @brief Template principal de l'application AgendSup
 *
 * @details Ce fichier définit la structure HTML commune à toutes les pages
 * de l'application AgendSup.
 *
 * Il contient :
 * - l'en-tête HTML (head)
 * - l'import des feuilles de style CSS
 * - l'import des librairies externes (Bootstrap, FullCalendar, FontAwesome)
 * - un header commun avec les boutons de navigation
 * - les blocs Twig extensibles par les autres pages
 *
 * @section twig_blocks Sections Twig
 *
 * @subsection block_title Bloc title
 * Permet aux pages filles de définir le titre de la page.
 *
 * @subsection block_body Bloc body
 * Contient le contenu principal spécifique à chaque page.
 *
 * @section libraries Librairies utilisées
 * - Bootstrap 5
 * - FullCalendar
 * - FontAwesome
 * - Google Fonts
 *
 * @version 1.0
 */
#}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="public/assets/css/style.css">
    <link rel="stylesheet" href="public/assets/css/login.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="public/assets/img/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet"><!--Love+Ya+Like+A+Sister-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <title>{% block title %}AgendSup{% endblock %}</title>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js'></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    
</head>
<body>

    <img id="imgBg" src="public/assets/img/background.png" alt="Fond d'AgendSup">
    <header class="btn-message">
    <button class="btn btn-dark rounded-pill shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMessages">
        <i class="fa-solid fa-comments me-2"></i> Messages
    </button>
        <div class="header-right">
        <button type="button" class="w-auto btn p-2 border btn-light rounded-circle" data-bs-toggle="modal" data-bs-target="#profilModal">
            <i class="fa-solid fa-user"></i>
        </button>
        <a href="?controleur=connecter&methode=render">
            <button class="w-auto btn p-2 border btn-light rounded-circle">
                <i class="fa-solid fa-house"></i>
            </button>
        </a>
        </div>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <div class="offcanvas offcanvas-end border-start border-dark rounded-start-5 shadow" tabindex="-1" id="offcanvasMessages" style="width: 400px;">
        <div class="offcanvas-header border-bottom border-dark bg-light">
            <h5 class="offcanvas-title fw-bold">MES DISCUSSIONS</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        
        <div class="offcanvas-body p-0">
            <div class="list-group list-group-flush">
                {# On boucle sur les chats récents envoyés par le contrôleur #}
                {% for chat in chatsRecents %}
                    <a href="?controleur=chat&methode=lister&id_chat={{ chat.id }}" class="list-group-item list-group-item-action p-3 border-bottom d-flex align-items-center gap-3">
                        <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 45px; height: 45px; min-width: 45px;">
                            {{ chat.Nom|slice(0, 1)|upper }}
                        </div>
                        <div class="overflow-hidden w-100">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 fw-bold">{{ chat.Nom }}</h6>
                                <small class="text-muted" style="font-size: 0.7rem;">{{ chat.date_dernier|slice(11, 5) }}</small>
                            </div>
                            <p class="mb-0 text-muted text-truncate small">
                                {{ chat.dernier_message|default('Pas encore de message') }}
                            </p>
                        </div>
                    </a>
                {% else %}
                    <div class="p-5 text-center text-muted small">
                        <i class="fa-solid fa-message mb-2 fa-2x"></i><br>
                        Aucune discussion pour le moment.
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="p-3 border-top border-dark bg-light text-center">
            <a href="?controleur=chat&methode=lister" class="btn btn-outline-dark rounded-pill btn-sm px-4">
                Voir toute la messagerie
            </a>
        </div>
    </div>

    {% include 'profil-modal.html.twig' %}
</body>
</html>