<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="public/assets/css/style.css">
    <link rel="stylesheet" href="public/assets/css/login.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="public/assets/img/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Love+Ya+Like+A+Sister&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <title>{% block title %}AgendSup{% endblock %}</title>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js'></script>
    
</head>
<body>
    <img id="imgBg" src="public/assets/img/background.png" alt="Fond d'AgendSup">
    <header class="btn-message">
    <a href="">
        <button class="w-auto btn p-2 border btn-light rounded-circle">
            <i class="fa-solid fa-message"></i>
        </button>
        </a>
        <div class="header-right">
        <a href="">
            <button class="w-auto btn p-2 border btn-light rounded-circle">
                <i class="fa-solid fa-user"></i>
            </button>
        </a>
        <a href="?controleur=connecter&methode=render">
            <button class="w-auto btn p-2 border btn-light rounded-circle">
                <i class="fa-solid fa-house"></i>
            </button>
        </a>
        </div>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>


    <script src="public/assets/js/login.js"></script>
</body>
</html>