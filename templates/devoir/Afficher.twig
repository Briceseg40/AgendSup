{#
/**
 * @file afficher.twig
 * @brief Page affichant la liste des devoirs pour les différentes classes.
 *
 * Cette vue affiche un tableau récapitulatif des devoirs stockés dans la
 * variable `categories`, avec leur ID, libellé, date de réalisation,
 * contenu et l'ID du cours associé. Hérite du template principal
 * `base.html.twig`.
 */
#}

{% extends "base.html.twig" %}

{% block title %}AgendSup - Liste des devoirs{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="public/assets/css/listerDevoir.css">
{% endblock %}

{% block body %}
{#  {{dump(categories)}}; #}

<table>
    <tr>
        <th>ID</th>
        <th>Libellé</th>
        <th>Date</th>
        <th>Contenu</th>
        <th>ID Cours</th>
    </tr>

    {% for devoirs in categories %}
        <tr>
            <td>{{ devoirs.id }}</td>
            <td>{{ devoirs.libelle }}</td>
            <td>{{ devoirs.date_a_realiser }}</td>
            <td>{{ devoirs.contenu }}</td>
            <td>{{ devoirs.idCours }}</td>
        </tr>
    {% endfor %}
</table>
{% endblock %}
