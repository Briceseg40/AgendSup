{#
/**
 * @file profil.html.twig
 * @brief Vue permettant d'afficher les informations personnelles de l'étudiant.
 *
 * @details Cette page affiche le profil détaillé de l'utilisateur connecté.
 * Elle utilise le même design que la page de sélection de classe pour 
 * assurer une cohérence visuelle dans l'application AgendSup.
 *
 * Champs affichés :
 * - Identité (Nom, Prénom, Rôle)
 * - Contact (Email)
 * - Scolarité (Année, Parcours, ID de classe)
 *
 * @project AgendSup
 * @author  Guénolé Mourzelas & Baptiste Marsaa
 * @version 1.2
 */
#}

{% extends "base.html.twig" %}

{% block title %}AgendSup - Mon Profil{% endblock %}

{% block body %}
	<div>
		<h3 class="mt-3 text-center">Mon Profil</h3>
		
		<div class="position-relative section-class bg-gray w-100 d-flex flex-column justify-content-center border-black border-1 align-items-center border p-5 mt-1">
            
            {# Zone Avatar / Image de profil #}
            <div class="mb-4 text-center">
                <div class="rounded-circle bg-white border border-dark d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 120px; height: 120px; overflow: hidden;">
                    <img src="public/assets/img/agendboyquisait.png" alt="Avatar" style="width: 100%; height: 100%; object-fit: contain;">
                </div>
                <h4 class="fw-bold mt-3 mb-0">{{ etudiant.getPrenom() }} {{ etudiant.getNom()|upper }}</h4>
                <span class="badge bg-dark rounded-pill px-3">{{ etudiant.getRole()|capitalize }}</span>
            </div>

            {# Liste des informations (style cards comme pour les classes) #}
			<div class="w-50 d-flex flex-column gap-2">
				
                {# Card : Informations Personnelles #}
                <div class="class-card btn btn-light border border-black p-3 w-100 text-start mb-2 shadow-sm" style="cursor: default;">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <i class="fa-solid fa-id-card fa-2x text-muted"></i>
                        </div>
                        <div class="col">
                            <div class="small text-muted fst-italic">Adresse Mail</div>
                            <div class="fw-bold">{{ etudiant.getMail() }}</div>
                        </div>
                    </div>
                </div>

                {# Card : Scolarité #}
                <div class="class-card btn btn-light border border-black p-3 w-100 text-start mb-2 shadow-sm" style="cursor: default;">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <i class="fa-solid fa-graduation-cap fa-2x text-muted"></i>
                        </div>
                        <div class="col">
                            <div class="small text-muted fst-italic">Parcours & Année</div>
                            <div class="fw-bold">
                                {{ etudiant.getParcour()|default('Non renseigné') }} 
                                - Année {{ etudiant.getAnnee() }}
                            </div>
                        </div>
                        <div class="col-auto text-end">
                            <div class="fw-bold small">Classe ID : #{{ etudiant.getIdClasse()|default('N/A') }}</div>
                        </div>
                    </div>
                </div>

                {# Card : Sécurité #}
                <div class="class-card btn btn-light border border-black p-3 w-100 text-start mb-2 shadow-sm" style="cursor: default;">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <i class="fa-solid fa-lock fa-2x text-muted"></i>
                        </div>
                        <div class="col">
                            <div class="small text-muted fst-italic">Mot de passe</div>
                            <div class="fw-bold">••••••••••••</div>
                        </div>
                    </div>
                </div>

			</div>
		</div>

        {# Boutons du bas (reprise du style exact de joinClasse) #}
		<div class="btn-class d-flex w-50 justify-content-between flex-row align-items-center mx-auto">
			<div class="d-flex flex-column align-items-right">
				<a href="?controleur=etudiant&methode=modifier" class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-3 mt-4 w-auto">
                    Modifier mes infos
                </a>
			</div>

			<div class="btn-right d-flex flex-column justify-content-end align-items-left">
				<a href="index.php" class="btn text-btn btn-light w-110px rounded-3 shadow border-black p-3 mt-4">
                    Retour
                </a>
			</div>
		</div>
	</div>
{% endblock %}