{#
    @file inscription_reussie.html.twig
    Page de confirmation d'inscription - version design AgendSup
#}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Inscription réussie - AgendSup</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Styles globaux -->
    <link rel="stylesheet" href="public/assets/css/style.css">
    <link rel="stylesheet" href="public/assets/css/login.css">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Love+Ya+Like+A+Sister&display=swap" rel="stylesheet">
</head>

<body>

<img id="imgBg" src="public/assets/img/background.png" alt="Fond AgendSup">
    
<div class="container">

    <div class="bg-gray position-absolute top-50 start-50 translate-middle hero text-center rounded-5 p-4" style="width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto;">
        
        <h1 class="titre">AgendSup</h1>
        <p class="mb-4 fs-20">CRÉER UN COMPTE</p>

        {% if errors %}
            <div class="alert alert-danger">
                <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if error == 'compte_existant' %}
            <div class="alert alert-danger">
                <h1>Erreur : Compte existant</h1>
                <p>Ce compte existe déjà.</p>
                <a href="#">Mot de passe oublié ?</a><br>
            </div>
        {% elseif error == 'mdp_faible' %}
            <div class="alert alert-danger">
                <h1>Erreur : Mot de passe invalide</h1>
                <p>Le mot de passe doit contenir au moins 8 caractères, une lettre majuscule, une lettre minuscule, un chiffre et un caractère spécial.</p>
            </div>
        {% elseif error %}
            <div class="alert alert-danger">
                <h1>Une erreur inattendue est survenue</h1>
                <p>{{ error }}</p>
            </div>
        {% endif %}
        
        <div class="hero-buttons position-relative d-flex flex-column gap-3 w-90 mx-auto">
            
            <form class="position-relative w-100 mx-auto" method="post" action="">
                
                <!-- Email -->
                <input type="email" name="email" class="form-control w-100 border-black mb-3 rounded-pill fs-20 p-20" placeholder="Email de l'établissement (nom@iutbayonne.univ-pau.fr)" required
                    title="Entrez une adresse email valide, comme pierre@iutbayonne.univ-pau.fr" value="{{ form_data.email ?? '' }}">
                <div class="row g-2 mb-3">
                    <!-- Sélecteur de Rôle sous forme de boutons -->
                    <div class="mb-3">
                        <label class="d-block mb-2 text-center fs-20">Choisissez votre rôle :</label>
                        <div class="d-flex gap-2 justify-content-center" id="role-container">
                            <input type="hidden" name="role" id="role_input" value="{{ form_data.role ?? '' }}" required>
                            
                            <!-- Bouton Étudiant -->
                            <button type="button" class="btn btn-light border-black flex-fill rounded-pill role-btn d-flex align-items-center justify-content-center gap-2 {% if form_data.role == '1' %}active{% endif %}" data-value="1">
                                Étudiant
                            </button>
                            <i class="fa-solid fa-circle-question text-muted" 
                                data-bs-toggle="popover" 
                                data-bs-trigger="focus" 
                                title="Rôle Étudiant" 
                                data-bs-content="Accès standard pour consulter l'emploi du temps de votre groupe."
                                tabindex="0" role="button"></i>

                            <!-- Bouton Délégué -->
                            <button type="button" class="btn btn-light border-black flex-fill rounded-pill role-btn d-flex align-items-center justify-content-center gap-2 {% if form_data.role == '2' %}active{% endif %}" data-value="2">
                                Délégué
                            </button>
                            <i class="fa-solid fa-circle-question text-muted" 
                                data-bs-toggle="popover" 
                                data-bs-trigger="focus" 
                                title="Rôle Délégué" 
                                data-bs-content="Étudiant délégué de son TD/TP ayant les droits pour créer et gérer les devoirs de son groupe.(Uniquement 1 par TP)"
                                tabindex="0" role="button"></i>

                            <!-- Bouton Ressource -->
                            <button type="button" class="btn btn-light border-black flex-fill rounded-pill role-btn d-flex align-items-center justify-content-center gap-2 {% if form_data.role == '3' %}active{% endif %}" data-value="3">
                                Ressource
                            </button>
                            <i class="fa-solid fa-circle-question text-muted" 
                                data-bs-toggle="popover" 
                                data-bs-trigger="focus" 
                                title="Rôle Ressource" 
                                data-bs-content="Rôle réservé aux étudiants en charge de ressources, peut créer des horaires de révisions lié à sa ressource."
                                tabindex="0" role="button"></i>
                        </div>
                    </div>
                </div>
                <!-- Nom & prenom -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <input type="text" name="name" class="form-control w-100 border-black mb-3 rounded-pill fs-20 p-20" placeholder="Nom" required
                            maxlength="15" minlength="2" title="Entrez un nom de 2 à 15 caractères." value="{{ form_data.name ?? '' }}">
                    </div>
                    <div class="col-6">
                        <input type="text" name="first_name" class="form-control w-100 border-black mb-3 rounded-pill fs-20 p-20" placeholder="Prénom" required
                            maxlength="15" minlength="2" title="Entrez un prénom de 2 à 15 caractères." value="{{ form_data.first_name ?? '' }}">
                    </div>
                </div>

                <!-- Mdp -->
                <div class="row g-2 mb-3">
                        <input type="password" name="password" class="form-control w-100 border-black rounded-pill fs-20 p-20" placeholder="Mot de passe" pattern= '^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&.])[A-Za-z\d@$!%*?&.].+$'
                            required maxlength="20" minlength="8" title="Entrez un mot de passe de 4 à 20 caractères avec au moins une majuscule, une minuscule, un chiffre et un caractère spécial.">
                            <label class="form-text text-muted">Le mot de passe doit contenir au moins 8 caractères, une lettre majuscule, une lettre minuscule, un chiffre et un caractère spécial.</label>
                </div>

                <!-- Promo & TD  -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <select name="promo" id="promo_group" class="form-select w-100 border-black rounded-pill fs-20 p-20" style="cursor: pointer;" required>
                            <option value="" disabled selected>Promo</option>
                            <option value="1" >1re année</option>
                            <option value="2" >2e année</option>
                            <option value="3" >3e année</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <select name="td_group" id="td_group" class="form-select w-100 border-black rounded-pill fs-20 p-20" style="cursor: pointer;" required>
                            <option value="" disabled selected>TD</option>
                            <option value="1" >TD 1</option>
                            <option value="2" >TD 2</option>
                            <option value="3" >TD 3</option>
                        </select>
                    </div>
                </div>

                <!-- Parcours & TP  -->
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <select name="parcours" id="parcours_group" class="form-select w-100 border-black rounded-pill fs-20 p-20" style="cursor: pointer;" required>
                            <option value="" disabled>Parcours</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <select name="tp_group" id="tp_group" class="form-select w-100 border-black rounded-pill fs-20 p-20" style="cursor: pointer;" required>
                            <option value="" disabled>TP</option>
                        </select>
                    </div>
                </div>


                <button type="submit" class="btn btn-light w-100 rounded-pill border-black p-3 text-btn mb-3">
                    S'ENREGISTRER <i class="fa-solid fa-arrow-right-to-bracket ms-1"></i>
                </button>

            </form>

            <div class="liens-compte fs-20 d-flex justify-content-center align-items-center mb-2">
                <span class="me-2">Déjà un compte ?</span>
                <a href="index.php?controleur=connecter&methode=connexion" class="fw-bold text-decoration-underline">Se connecter</a>
            </div>
        </div>
    </div>
</div>

<script>
    // Gestion dynamique des TP en fonction du TD
    
    const tpOptions = {
        1: [{value: 1, label: 'TP 1'}, {value: 2, label: 'TP 2'}],
        2: [{value: 3, label: 'TP 3'}, {value: 4, label: 'TP 4'}],
        3: [{value: 5, label: 'TP 5'}, {value: 6, label: 'TP 6'}],
    };

    const tdSelect = document.getElementById('td_group');
    const tpSelect = document.getElementById('tp_group');

    tdSelect.addEventListener('change', () => {
        const tdValue = tdSelect.value;
        tpSelect.innerHTML = '<option value="" disabled>TP</option>'; // reset
        if (tpOptions[tdValue]) {
            tpOptions[tdValue].forEach(tp => {
                const opt = document.createElement('option');
                opt.value = tp.value;
                opt.text = tp.label;
                tpSelect.add(opt);
            });
        }
    });
</script>

<script>
    // Gestion dynamique des parcours en fonction de la promo
    const parcoursOptions = {
        1 : [{value: 'N', label: 'Aucun'}],
        2 : [{value: 'A', label: 'RACDV (A)'}, {value: 'D', label: 'IAMSI (D)'}],
        3 : [{value: 'A', label: 'RACDV (A)'}, {value: 'D', label: 'IAMSI (D)'}]
    };

    const promoSelect = document.getElementById('promo_group');
    const parcoursSelect = document.getElementById('parcours_group');

    promoSelect.addEventListener('change', ()=> {
        const promoValue = promoSelect.value;
        parcoursSelect.innerHTML = '<option value="" disabled>Parcours</option>';
        if (parcoursOptions[promoValue]) {
            parcoursOptions[promoValue].forEach(parcours => {
                const opt = document.createElement('option');
                opt.value = parcours.value;
                opt.text = parcours.label;
                parcoursSelect.add(opt);
            });
        }
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
        var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
            return new bootstrap.Popover(popoverTriggerEl)
        })
    });
    // Gestion de la sélection du rôle par boutons
    const roleButtons = document.querySelectorAll('.role-btn');
    const roleInput = document.getElementById('role_input');

    roleButtons.forEach(button => {
        button.addEventListener('click', function() {
            // 1. Retirer la classe 'active' de tous les boutons
            roleButtons.forEach(btn => btn.classList.remove('active', 'btn-dark', 'text-white'));
            roleButtons.forEach(btn => btn.classList.add('btn-light'));

            // 2. Ajouter la classe 'active' au bouton cliqué
            this.classList.add('active', 'btn-dark', 'text-white');
            this.classList.remove('btn-light');

            // 3. Mettre à jour la valeur de l'input caché
            roleInput.value = this.getAttribute('data-value');
        });
    });

    // Si une valeur existe déjà (rechargement de page), on l'active visuellement
    const currentValue = roleInput.value;
    if (currentValue) {
        const activeBtn = document.querySelector(`.role-btn[data-value="${currentValue}"]`);
        if (activeBtn) activeBtn.click();
    }
</script>