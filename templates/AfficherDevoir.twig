{#
/**
 * @file afficherdevoir.twig
 * @brief Affichage du calendrier des devoirs via FullCalendar
 *
 * @details Cette page affiche un calendrier hebdomadaire contenant les devoirs
 * récupérés depuis une API interne (`devoir/api_events`).
 *
 * Le calendrier utilise la librairie FullCalendar avec :
 * - une vue semaine (timeGridWeek)
 * - des créneaux de 15 minutes
 * - un affichage de 8h à 19h
 * - la localisation en français
 *
 * Des popovers Bootstrap sont affichés au survol des événements
 * pour montrer les descriptions des devoirs.
 *
 * @version 1.0
 */
#}

{% extends "base.html.twig" %}

{% block title %}AgendSup - Liste des devoirs{% endblock %}


{% block body %}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek',
            slotDuration: '00:15', 
            slotMinTime: '08:00:00',
            slotMaxTime: '19:00:00',
            nowIndicator: true,
            contentHeight: 450,
            locale: 'fr',
            backgoundColor: '#808080',
            headerToolbar: {
                left: '',
                center: 'title prev next today',
                right: ''
            },
             
            events: 'index.php?controleur=devoir&methode=api_events',

            eventDidMount: function (info) {
            const description = info.event.extendedProps.description;
            if (!description) return;

                new bootstrap.Popover(info.el, {
                title: info.event.title,
                content: description,
                trigger: 'hover focus',
                placement: 'top',
                html: true,
                container: 'body'
                 });
            },

            eventSourceFailure: function() {
            alert("Erreur : Impossible de charger les données depuis l'API.");
            },
            // Optionnel : s'assurer que les dates s'affichent même si l'heure est absente
            displayEventTime: true,
            eventTextColor: 'white',
        });
        
        calendar.render();
    });
</script>


{% if app.user and app.user.role == 'delegue' %}
    <div class="mb-3 text-end">
        <a href="index.php?controleur=devoir&methode=lister" 
           class="btn btn-primary shadow" 
           style="position: fixed; bottom: 20px; right: 20px; z-index: 1000; border-radius: 50px; padding: 10px 20px;">
            Liste des devoirs
        </a>
    </div>

{% elseif app.user.role == 'ressource' %}
    <div class="mb-3 text-end">
        <a href="index.php?controleur=devoir&methode=lister" 
           class="btn btn-primary shadow" 
           style="position: fixed; bottom: 40px; right: 20px; z-index: 1000; border-radius: 50px; padding: 10px 20px;">
            Liste des cours
        </a>
    </div>
{% endif %}   

<div class="container mt-4">
    <div id='calendar'></div>
</div>

{% endblock %}