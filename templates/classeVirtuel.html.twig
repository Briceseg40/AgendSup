{% extends "base.html.twig" %}

{% block title %}AgendSup - Classe Virtuelle{% endblock %}

{% block stylesheets %}{% endblock %}

{% block body %}
<div class="position-absolute bottom-30px left-10px w-100 d-flex p-3" style="z-index:2;">
    <button onclick="history.back()" 
        class="btn btn-normal btn-dark rounded-3 shadow-sm px-4 py-2">
        <i class="fa-solid fa-arrow-left me-2"></i>
        Quitter la classe
    </button>
</div>

<div class="container-fluid position-absolute bottom-0 start-0 p-3" style="top: 40px;">
    <div class="row h-100 g-3">
        <div class="h-100">
            <div class="card h-100 border-2 border-black rounded-4 overflow-hidden position-relative shadow-lg">
                <div class="position-absolute top-0 end-0 m-3" style="z-index:20;">
                    <button class="btn btn-normal btn-primary rounded-circle shadow"
                            style="width:45px; height:45px;"
                            onclick="toggleVocal()">
                        <i class="fa-solid fa-microphone"></i>
                    </button>
                </div>
                <iframe 
                    src="https://wbo.ophir.dev/boards/AgendSup_Classe_{{ idClasse }}" 
                    style="width: 100%; height: 100%; border: none;">
                </iframe>
            </div>
        </div>
    </div>
</div>

<div id="vocalOverlay" 
     class="position-fixed top-0 end-0 h-100 bg-white shadow-lg d-none"
     style="width: 20%; z-index:2000;">

    <div class="bg-black text-white text-center p-2">
        Salon Vocal
        <button class="btn btn-sm btn-light float-end" onclick="toggleVocal()">X</button>
    </div>

    <div id="jitsi-container" style="width:100%; height:95%;"></div>
</div>

{% set cleanName = userName|replace({' ': '', '.': '', '@': ''})|trim %}

<div class="modal fade" id="rulesModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content rounded-4 shadow">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title">
          🎓 Bienvenue dans la classe virtuelle
        </h5>
      </div>

      <div class="modal-body px-4 py-3">
        <p class="mb-4">
          Avant de commencer, voici quelques règles simples pour que tout se passe bien 👇
        </p>

        <div class="p-3 mb-3 rounded-3 bg-light border">
          <h6 class="fw-bold mb-3">📌 Respect & Collaboration</h6>
          <p class="mb-2">🤝 Soyez respectueux et constructif.</p>
          <p class="mb-2">🧽 Ne supprimez pas le travail des autres sans accord.</p>
          <p class="mb-0">📚 Utilisez le tableau uniquement à des fins pédagogiques.</p>
        </div>

        <div class="p-3 mb-3 rounded-3 bg-light border">
          <h6 class="fw-bold mb-3">🎤 Salon vocal</h6>
          <p class="mb-2">🎙 Activez votre micro uniquement pour parler.</p>
          <p class="mb-2">🔇 Coupez-le en cas de bruit parasite.</p>
          <p class="mb-0">🗣 Respectez les tours de parole.</p>
        </div>

        <div class="p-3 mb-3 rounded-3 bg-light border">
          <h6 class="fw-bold mb-3">⚙️ Bon fonctionnement</h6>
          <p class="mb-2">🌐 Une connexion stable est recommandée.</p>
          <p class="mb-2">📝 Les contenus doivent rester liés au cours.</p>
          <p class="mb-0">⚠️ Un comportement inapproprié peut entraîner une exclusion.</p>
        </div>

        <div class="text-center my-3">
          <img src="https://media.giphy.com/media/l0MYt5jPR6QX5pnqM/giphy.gif" 
               alt="Good vibes"
               style="max-width:120px; border-radius:12px;">
        </div>

        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="dontShow">
          <label class="form-check-label text-muted small" for="dontShow">
            Ne plus afficher ce message pendant cette session
          </label>
        </div>
      </div>

      <div class="modal-footer justify-content-center">
        <button class="btn btn-normal btn-dark px-4" data-bs-dismiss="modal">
          C'est parti 🚀
        </button>
      </div>
    </div>
  </div>
</div>

<script src="https://meet.jit.si/external_api.js"></script>

<script>
let jitsiApi = null;
let jitsiLoaded = false;

document.addEventListener("DOMContentLoaded", function () {

    if (!localStorage.getItem("hideRulesModal")) {
        let modal = new bootstrap.Modal(document.getElementById('rulesModal'));
        modal.show();
    }

    document.getElementById("dontShow").addEventListener("change", function() {
        if (this.checked) {
            localStorage.setItem("hideRulesModal", "true");
        } else {
            localStorage.removeItem("hideRulesModal");
        }
    });
});

document.addEventListener("wheel", function(e) {
    if (e.ctrlKey) {
        e.preventDefault();
    }
}, { passive: false });

function toggleVocal() {
    const overlay = document.getElementById('vocalOverlay');
    overlay.classList.toggle('d-none');

    if (!jitsiLoaded) {
        const domain = "meet.jit.si";

        const options = {
            roomName: "AgendSup_{{ idClasse }}",
            parentNode: document.querySelector('#jitsi-container'),
            userInfo: {
                displayName: "{{ cleanName }}"
            },
            configOverwrite: {
                startWithVideoMuted: true,
                startWithAudioMuted: false,
                prejoinPageEnabled: false
            },
            interfaceConfigOverwrite: {
                SHOW_JITSI_WATERMARK: false,
                SHOW_BRAND_WATERMARK: false
            }
        };

        jitsiApi = new JitsiMeetExternalAPI(domain, options);
        jitsiLoaded = true;
    }
}
</script>

{% endblock %}