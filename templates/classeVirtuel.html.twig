{% extends "base.html.twig" %}

{% block title %}AgendSup - Classe Virtuelle{% endblock %}

{% block stylesheets %}{% endblock %}

{% block body %}
<div class="position-absolute bottom-0 w-100 d-flex p-3" style="z-index:1000;">
    <button onclick="history.back()" 
        class="btn btn-dark rounded-3 shadow-sm px-4 py-2">
        <i class="fa-solid fa-arrow-left me-2"></i>
        Quitter la classe
    </button>
</div>
    <div class="container-fluid position-absolute bottom-0 start-0 p-3" style="top: 40px;">
        
        <div class="row h-100 g-3">
            
            <!-- COLONNE GAUCHE : TABLEAU -->
            <div class="col-md-11 h-100">
                <div class="card h-100 border-2 border-black rounded-4 overflow-hidden position-relative shadow-lg">
                    <div class="position-absolute top-0 start-0 bg-black text-white px-3 py-1 rounded-bottom-end" style="z-index: 10;">
                        <i class="fa-solid fa-pen-to-square me-2"></i> Tableau Blanc
                    </div>
                    
                    <iframe 
                        src="https://wbo.ophir.dev/boards/AgendSup_Classe_{{ idClasse }}" 
                        style="width: 100%; height: 100%; border: none;">
                    </iframe>
                </div>
            </div>

            <!-- COLONNE DROITE : VOCAL -->
            <div class="position-fixed top-0 end-0 p-3" style="z-index:1000;">
    <button class="btn btn-primary shadow" onclick="toggleVocal()">
        <i class="fa-solid fa-microphone"></i>
    </button>
</div>

        </div>
    </div>
    <div id="vocalOverlay" 
     class="position-fixed top-0 end-0 h-100 bg-white shadow-lg d-none"
     style="width: 25%; z-index:2000;">

    <div class="bg-black text-white text-center p-2">
        Salon Vocal
        <button class="btn btn-sm btn-light float-end" onclick="toggleVocal()">X</button>
    </div>

    {% set cleanName = userName|replace({' ': '', '.': '', '@': ''})|trim %}

    <iframe 
        src="https://vdo.ninja/vdo?room=AgendSup_{{ idClasse }}&label={{ cleanName }}&novideo" 
        style="width:100%; height:95%; border:none;"
        allow="camera; microphone; autoplay; encrypted-media; display-capture">
    </iframe>
</div>
<script>
document.addEventListener("wheel", function(e) {
    if (e.ctrlKey) {
        e.preventDefault();
    }
}, { passive: false });

function toggleVocal() {
    document.getElementById('vocalOverlay').classList.toggle('d-none');
}

</script>
{% endblock %}