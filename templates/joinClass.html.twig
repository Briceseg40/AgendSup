{#
/**
 * @file joinClasse.html.twig
 * @brief Vue permettant à l'utilisateur de rechercher et rejoindre une classe.
 *
 * @details Cette page affiche une liste de classes disponibles sous forme de cartes 
 * sélectionnables. L'utilisateur peut choisir une classe, la rejoindre, 
 * en supprimer une (si autorisé) ou naviguer vers la création de classe.
 *
 * Fonctionnalités principales :
 * - Affichage dynamique des classes via Twig.
 * - Sélection interactive en JavaScript (mise en évidence visuelle).
 * - Formulaire de soumission vers le contrôleur de gestion des classes.
 *
 * Technologies utilisées :
 * - Twig (Moteur de template)
 * - Bootstrap 5 & FontAwesome 6
 * - JavaScript (DOM manipulation)
 *
 * @see JoinClassController
 * @see ParamClasseController
 * @version 1.1
 */
#}

{% extends "base.html.twig" %}

{% block title %}AgendSup - Rejoindre une classe
{% endblock %}

{% block stylesheets %}{% endblock %}

{% block body %}
	<div>
		<h3 class="mt-3 text-center">Rejoindre une classe</h3>
		<div class="position-relative section-class bg-gray w-100 d-flex flex-column justify-content-center border-black border-1 align-items-center border p-5 mt-1">
		{% if error_message or success_message %}
    <div class="position-absolute w-50 text-center" style="top: 0; z-index: 20;">
        
        {% if error_message %}
            <div class="text-danger fw-semibold">
                                {{ error_message }}
            </div>
        {% endif %}

        {% if success_message %}
     <div id="successMessage" class="text-success fw-semibold">
            {{ success_message }}
    </div>

    <script>
        setTimeout(() => {
            const msg = document.getElementById('successMessage');
            if (msg) {
                msg.style.transition = "opacity 0.5s ease";
                msg.style.opacity = "0";
                setTimeout(() => msg.remove(), 500);
            }
        }, 5000);
    </script>
{% endif %}

    </div>
{% endif %}

            <form method="post" action="?controleur=joinClass&methode=rejoindreParCode" class="input-group w-50 position-absolute mb-4 top-30px" style="z-index: 10;">
                <span class="input-group-text">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="search" name="code_classe" class="form-control" placeholder="Tapez le code de la classe..." required>
                <button type="submit" class="btn btn-dark">
				<i class="bi bi-plus-circle"></i> Ajouter</button>
            </form>

            <form id="actionForm" method="post" action="?controleur=joinClass&methode=action" class="w-100 d-flex flex-column align-items-center">

				<input type="hidden" name="id_classe" id="selectedClassId" required>
				<div class="w-50 d-flex flex-column gap-2 overflow-auto mt-40 custom-scroll mh-45vh">
					{% for classe in classes %}
						<div class="class-card btn btn-light border border-black p-3 w-100 text-start mb-2 position-relative" onclick="selectClass(this, {{ classe.getId() }})" style="cursor: pointer;">

							<div class="row align-items-center g-3">
								<div class="col-auto">
									{% if classe.getImage() %}
										<img src="{{ classe.getImage() }}" alt="Logo" class="rounded bg-white border border-dark" style="width: 80px; height: 80px; object-fit: contain;">
									{% else %}
										<img src="public/assets/img/agendboyquisait.png" alt="Defaut" class="rounded bg-white border border-dark" style="width: 80px; height: 80px; object-fit: contain;">
									{% endif %}
								</div>

								<div class="col text-start">
									<div class="d-flex align-items-center mb-1 gap-2">
										<h5 class="fw-bold mb-0">{{ classe.getTitre() }}</h5>
									</div>
									<p class="mb-0 text-muted small fst-italic">{{ classe.getDescription() }}</p>
									<p class="mb-0 text-muted small fst-italic fw-bold">Code : {{ classe.getCode() }}</p>
								</div>

								<div class="col-auto text-end">
									<span class="badge bg-success rounded-pill" style="font-size: 0.7rem;">
										Connexion stable
										<i class="fa-solid fa-signal ms-1"></i>
									</span>
									
									<div class="fw-bold text-muted small">
										Crée par : {{ classe.nomCreateur|default('Inconnu') }} {{ classe.prenomCreateur }}
									</div>
									
								</div>
							</div>
						</div>
					{% else %}
						<p class="text-center mt-3 fw-bold">Aucune classe disponible pour le moment.</p>
					{% endfor %}
				</div>
			</div>
			<div class="btn-class d-flex w-50 justify-content-between flex-row align-items-center mx-auto">
				<div class="d-flex flex-column align-items-right">
					<button type="submit" name="action_type" value="rejoindre" class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-3 mt-4 w-auto fw-bold">Rejoindre la classe</button>
					<button type="button" 
        class="btn text-btn btn-light ms-auto rounded-3 shadow border-black p-3 mt-4 fw-bold"
        onclick="openUnsubscribeModal()">
    Se désinscrire
</button>
				</div>

				<div class="btn-right d-flex flex-column justify-content-end align-items-left">
					<a href="?controleur=paramclasse&methode=render" class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-3 mt-4 w-auto fw-bold">Créer une classe</a>
					<a href="?controleur=connecter&methode=render" class="btn text-btn btn-light w-110px rounded-3 shadow border-black p-3 mt-4 fw-bold">Retour</a>
				</div>
			</div>

		</form>
	</div>
<!-- Modal Désinscription -->
<!-- Modal Désinscription -->
<div class="modal fade" id="unsubscribeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">

            <div class="modal-header border-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center pt-0">

                <i class="fa-solid fa-triangle-exclamation text-danger fs-1 mb-3"></i>

                <h5 class="fw-bold mb-3">
                    Se désinscrire de « <span id="className"></span> » ?
                </h5>

                <p class="text-muted mb-0">
                    Vous n’aurez plus accès au contenu et cette classe disparaîtra de votre tableau de bord.
                </p>

            </div>

            <div class="modal-footer border-0 justify-content-center gap-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    Annuler
                </button>

                <button type="button" class="btn btn-danger px-4" onclick="confirmUnsubscribe()">
                    Oui, se désinscrire
                </button>
            </div>

        </div>
    </div>
</div>
	<script>
		function selectClass(elementDiv, idClasse) {
document.getElementById('selectedClassId').value = idClasse;

document.querySelectorAll('.class-card').forEach(div => {
div.classList.remove('selected');
div.classList.remove('border-3');
const badge = div.querySelector('.check-badge');
if (badge) {
badge.classList.add('d-none');
badge.classList.remove('d-flex');
}
});

elementDiv.classList.add('selected');
elementDiv.classList.add('border-3');
const badge = elementDiv.querySelector('.check-badge');
if (badge) {
badge.classList.remove('d-none');
badge.classList.add('d-flex');
}
}
function openUnsubscribeModal() {

    const selectedId = document.getElementById('selectedClassId').value;

    if (!selectedId) {
        alert("Veuillez sélectionner une classe.");
        return;
    }

    const selectedCard = document.querySelector('.class-card.selected');
    const titre = selectedCard.querySelector('h5').innerText;

    document.getElementById('className').innerText = titre;

    const modal = new bootstrap.Modal(document.getElementById('unsubscribeModal'));
    modal.show();
}

function confirmUnsubscribe() {

    const form = document.getElementById('actionForm');

    const inputAction = document.createElement('input');
    inputAction.type = 'hidden';
    inputAction.name = 'action_type';
    inputAction.value = 'supprimer';

    form.appendChild(inputAction);
    form.submit();
}
	</script>
{% endblock %}
