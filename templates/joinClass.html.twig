{% extends "base.html.twig" %}

{% block title %}AgendSup - Rejoindre une classe
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="public/assets/css/joinClass.css">
{% endblock %}

{% block body %}
	<h3 class="mt-5 text-center">Rejoindre une classe</h3>
	<div class="position-relative section-class bg-gray w-100 d-flex flex-column justify-content-center border-black border-1  align-items-center border p-5 mt-3">
		<div class="input-group w-50 position-absolute mb-4 top-30px">
			<span class="input-group-text">
				<i class="fa-solid fa-magnifying-glass"></i>
			</span>
			<input type="search" class="form-control" placeholder="Saisissez votre recherche">
		</div>
		<div class="">

			<p class="p-2 m-0 border-bottom border-black">Classe de Mathématiques</p>
			<p class="p-2 m-0 border-bottom border-black">Classe de Physique</p>
			<p class="p-2 m-0 border-bottom border-black">Classe de Chimie</p>
			<p class="p-2 m-0 border-bottom border-black">Classe de Français</p>
			<p class="p-2 m-0 border-bottom border-black">Classe d'Histoire-Géographie</p>
		</div>
	</div>


</div>

<div class="btn-class d-flex w-40 justify-content-between flex-row align-items-center mx-auto">
	<div class="d-flex flex-column align-items-right mt-4">
		<button class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-1 mt-4 w-auto">Rejoindre la classe</button>
		<button class="btn text-btn btn-light ms-auto w-140px rounded-3 shadow border-black p-1 mt-4 ">Supprimer</button>
	</div>
	<div class="btn-right d-flex flex-column justify-content-end align-items-left mt-4">
		<button class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-1 mt-4 w-auto">Ajout d'une classe</button>
		<a class="btn text-btn btn-light w-110px rounded-3 shadow border-black p-1 mt-4 ">Retour</a>
	</div>
</div>
{# <button class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-3 mt-5 w-auto">Se déconnecter</button> #}{% endblock %}

