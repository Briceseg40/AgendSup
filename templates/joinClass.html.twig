{% extends "base.html.twig" %}

{% block title %}AgendSup - Rejoindre une classe
{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block body %}
<div>
	<h3 class="mt-5 text-center">Rejoindre une classe</h3>
	<div class="position-relative section-class bg-gray w-100 d-flex flex-column justify-content-center border-black border-1 align-items-center border p-5 mt-3">
		<div class="input-group w-50 position-absolute mb-4 top-30px">
			<span class="input-group-text">
				<i class="fa-solid fa-magnifying-glass"></i>
			</span>
			<input type="search" class="form-control" placeholder="Saisissez votre recherche">
		</div>
		
		<div class="w-50 d-flex flex-column gap-2 overflow-auto mt-40 custom-scroll" >
			{% for classe in classes %}
				<button type="button" class="btn btn-light border border-black text-start p-3 d-flex flex-column w-100 class-item" data-id="{{ classe.getId() }}">
				<img src="{{class.getImage}}">
					<div class="d-flex justify-content-between w-100 align-items-center mb-1">
						<span class="fw-bold fs-5">{{ classe.getTitre() }}</span>
						<span class="badge bg-secondary">{{ classe.getFormation() }} - Année {{ classe.getAnnee() }}</span>
					</div>
					<div class="mb-2 text-muted">{{ classe.getDescription() }}</div>
					<div class="small fw-bold">
						{{ classe.getTD() }} - {{ classe.getTP() }}
					</div>
				</button>
			{% else %}
				<p class="text-center mt-3 fw-bold">Aucune classe disponible pour le moment.</p>
			{% endfor %}
		</div>
	</div>
</div>

<div class="btn-class d-flex w-30 justify-content-between flex-row align-items-center mx-auto">
	<div class="d-flex flex-column align-items-right mt-4">
		<button class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-3 mt-4 w-auto">Rejoindre la classe</button>
		<button class="btn text-btn btn-light ms-auto  rounded-3 shadow border-black p-3 mt-4 ">Supprimer</button>
	</div>
	<div class="btn-right d-flex flex-column justify-content-end align-items-left mt-4">
		<button class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-3 mt-4 w-auto">Ajout d'une classe</button>
		<a href="?controleur=connecter&methode=render" class="btn text-btn btn-light w-110px rounded-3 shadow border-black p-3 mt-4 ">Retour</a>
	</div>
</div>
{# <button class="btn text-btn btn-light w-100 rounded-3 shadow border-black p-3 mt-5 w-auto">Se déconnecter</button> #}{% endblock %}

