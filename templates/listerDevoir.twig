{% extends "base.html.twig" %}

{% block title %}AgendSup - Liste des devoirs{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3">📅 {{ titre }}</h2>
        <a href="index.php?controleur=devoir&methode=creer" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Ajouter un devoir
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Matière</th>
                            <th>Dates (Début/Fin)</th>
                            <th>Horaires (Début/Fin)</th>
                            <th>Description</th>
                            <th>Priorité</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for devoir in devoirs %}
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-dark">{{ devoir.libelle }}</span>
                            </td>

                            {# Colonne Dates uniquement #}
                            <td>
                                <div class="small">
                                    <div class="text-nowrap">
                                        <i class="bi bi-calendar-plus text-primary"></i> {{ devoir.dateDeb|date("d/m/Y") }}
                                    </div>
                                    <div class="text-nowrap text-danger fw-semibold">
                                        <i class="bi bi-calendar-check"></i> {{ devoir.datefin|date("d/m/Y") }}
                                    </div>
                                </div>
                            </td>

                            {# Colonne Horaires uniquement #}
                            <td>
                                <div class="small">
                                    <div class="text-nowrap text-muted">
                                        <i class="bi bi-clock"></i> {{ devoir.heureDeb }}
                                    </div
                                    <div class="text-nowrap text-danger">
                                        <i class="bi bi-alarm"></i> {{ devoir.heureFin }}
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="text-muted small text-truncate" style="max-width: 180px;" title="{{ devoir.contenu }}">
                                    {{ devoir.contenu }}
                                </div>
                            </td>
                            
                            <td>
                                <span class="badge rounded-circle p-2" style="background-color: {{ devoir.couleur }}; border: 1px solid #dee2e6;"></span>
                            </td>

                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a href="index.php?controleur=devoir&methode=modifier&id={{ devoir.id }}" 
                                       class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1">
                                        <i class="bi bi-pencil-square"></i> <span>Modifier</span>
                                    </a>
                                    <a href="index.php?controleur=devoir&methode=supprimer&id={{ devoir.id }}" 
                                       class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" 
                                       onclick="return confirm('Voulez-vous supprimer ce devoir ?')">
                                        <i class="bi bi-trash3"></i> <span>Supprimer</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <p class="text-muted mb-0">Aucun devoir à afficher.</p>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}