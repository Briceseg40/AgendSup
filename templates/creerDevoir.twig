                        </optgroup>
                    <optgroup label="SAE Semestre 5">
                            <option value="SAÉ 5.01 : Développement avancé / Adaptation de Système d'Information">SAÉ 5.01 : Développement avancé / Adaptation de Système d'Information</option>
                            <option value="PORTFOLIO S5 : Démarche portfolio">PORTFOLIO S5 : Démarche portfolio</option>
                        </optgroup>
                    
                    {% if app.user.Parcour == 'A' %}
                            <optgroup label="Ressource Parcours A">
                                <option value="R5.A.04 : Qualité algorithmique">R5.A.04 : Qualité algorithmique</option>
                                <option value="R5.A.05 : Programmation avancée">R5.A.05 : Programmation avancée</option>
                                <option value="R5.A.06 : Sensibilisation à la programmation multimédia">R5.A.06 : Sensibilisation à la programmation multimédia</option>
                                <option value="R5.A.07 : Automatisation de la chaîne de production">R5.A.07 : Automatisation de la chaîne de production</option>
                                <option value="R5.A.08 : Qualité de développement">R5.A.08 : Qualité de développement</option>
                                <option value="R5.A.09 : Virtualisation avancée">R5.A.09 : Virtualisation avancée</option>
                                <option value="R5.A.10 : Nouveaux paradigmes de base de données">R5.A.10 : Nouveaux paradigmes de base de données</option>
                                <option value="R5.A.11 : Méthodes d'optimisation pour l'aide à la décision">R5.A.11 : Méthodes d'optimisation pour l'aide à la décision</option>
                                <option value="R5.A.12 : Modélisations mathématiques">R5.A.12 : Modélisations mathématiques</option>
                                <option value="R5.A.13 : Économie durable et numérique">R5.A.13 : Économie durable et numérique</option>
                                <option value="R5.A.14 : Anglais">R5.A.14 : Anglais</option>
                                <option value="R5.A.15 : Éco-conception logicielle">R5.A.15 : Éco-conception logicielle</option>
                            </optgroup>
