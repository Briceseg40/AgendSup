{% extends "base.html.twig" %}

{% block title %}AgendSup - Création de devoirs{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 class="mb-4">Création d'un Devoir</h2>
        <form action="index.php?controleur=devoir&methode=creer" method="post" enctype="multipart/form-data">

            <div class="mb-3">
                <label for="idCours" class="form-label">Matière / Ressource</label>
                <select name="idCours" id="idCours" class="form-select" required>
                    <option value="" selected disabled>-- Sélectionnez une matière --</option>
                
                    {% set currentSemestre = "" %}
                    {% set currentType = "" %}

                    {% for cours in lesCours %}
                        {% set typeCours = cours.libelle|slice(0, 1) == 'S' ? 'SAÉ' : 'Ressources' %}
                        {% set groupLabel = "Semestre " ~ cours.semestre ~ " - " ~ typeCours %}

                        {% if cours.semestre != currentSemestre or typeCours != currentType %}
                            {% if currentSemestre != "" %}</optgroup>{% endif %}
                            <optgroup label="{{ groupLabel }}">
                            {% set currentSemestre = cours.semestre %}
                            {% set currentType = typeCours %}
                        {% endif %}

                        <option value="{{ cours.id }}">{{ cours.libelle }}</option>
                    {% endfor %}
                    
                    {% if currentSemestre != "" %}</optgroup>{% endif %}
                </select>
            </div>

            <div class="row g-2"> <div class="col-md-3 mb-3">
                    <label for="date_deb" class="form-label small">Date de début *</label>
                    <input type="date" class="form-control form-control-sm" id="date_deb" name="date_deb" required>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="date_fin" class="form-label small">Date de fin *</label>
                    <input type="date" class="form-control form-control-sm" id="date_fin" name="date_fin" required>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="heure_deb" class="form-label small">Heure de début *</label>
                    <input type="time" class="form-control form-control-sm" id="heure_deb" name="heure_deb" required>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="heure_fin" class="form-label small">Heure de fin *</label>
                    <input type="time" class="form-control form-control-sm" id="heure_fin" name="heure_fin" required>
                </div>
            </div>

            <div class="mb-3">
                <label for="contenu" class="form-label">Consignes / Contenu</label>
                <textarea class="form-control" id="contenu" name="contenu" rows="3" placeholder="Description du travail à faire..." required></textarea>
            </div>

            <div class="mb-3" style="max-width: 300px;">
                <label for="Couleur" class="form-label small">Couleur</label>
                <select class="form-select form-select-sm" id="Couleur" name="Couleur">
                    <option value="Blue">Bleu</option>
                    <option value="purple">Violet</option>
                    <option value="Green">Vert</option>
                    <option value="Yellow">Jaune</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success w-100">Enregistrer dans l'agenda</button>
        </form>
    </div>

    <script>
        const dateDeb = document.getElementById('date_deb');
        const dateFin = document.getElementById('date_fin');
        const today = new Date().toISOString().split('T')[0];
        
        dateDeb.value = today;
        dateFin.value = today;

        dateDeb.addEventListener('change', () => {
            dateFin.value = dateDeb.value;
        });
    </script>
{% endblock %}