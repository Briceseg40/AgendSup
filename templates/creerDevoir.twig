                            </optgroup>
                        {% elseif app.user.Parcour == 'D' %}
                            <optgroup label="Ressource Parcours D">
                                <option value="R4.D.08 : Réseau avancé">R4.D.08 : Réseau avancé</option>
                                <option value="R4.D.09 : Outils mathématiques pour la gestion">R4.D.09 : Outils mathématiques pour la gestion</option>
                                <option value="R4.D.10 : Management avancé des systèmes d'information">R4.D.10 : Management avancé des systèmes d'information</option>
                                <option value="R4.D.11 : Ergonomie">R4.D.11 : Ergonomie</option>
                            </optgroup>
                        {% endif %}

                    {% endif %}

                     {% if app.user and app.user.Annee == 3 %}
                    <optgroup label="Ressources Semestre 5">
                        <option value="R5.01 : Initiation au management d'une équipe de projet informatique">R5.01 : Initiation au management d'une équipe de projet informatique</option>
