{#
/**
 * @file creerDevoir.html.twig
 * @brief Page de création d'un devoir
 *
 * Cette page permet à un utilisateur autorisé (délégué ou enseignant)
 * de créer un nouveau devoir associé à une ressource / matière.
 *
 * Le formulaire inclut :
 * - la sélection de la matière (par semestre)
 * - les dates et heures de début et de fin
 * - une zone de description avec compteur de caractères
 * - une couleur de priorité pour l'affichage dans l'agenda
 *
 * Les données sont envoyées en POST vers le contrôleur Devoir
 * pour être enregistrées en base de données.
 *
 * @section validation Validation côté client
 * Plusieurs vérifications JavaScript sont réalisées :
 * - initialisation des dates à la date du jour
 * - synchronisation des dates (fin ≥ début)
 * - compteur dynamique de caractères (max 1000)
 * - vérification chronologique finale avant soumission
 *
 * @section access Accès à la page
 * L'accès à cette page est réservé aux utilisateurs disposant
 * des droits nécessaires pour créer des devoirs.
 *
 * @see base.html.twig
 * @see DevoirController
 * @author Groupe AgendSup
 * @version 1.0
 */
#}

{% extends "base.html.twig" %}

{% block title %}AgendSup - Création de devoirs{% endblock %}

{% block body %}
    <div class="container mt-3"> {# mt-3 pour remonter le formulaire #}
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card shadow border-0">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                        <h3 class="mb-0 h6"><i class="bi bi-plus-circle"></i> Création d'un Devoir</h3>
                        <a href="index.php?controleur=devoir&methode=lister" class="btn btn-sm btn-light">Retour</a>
                    </div>
                    
                    <div class="card-body p-4">
                        {# Message d'erreur serveur #}
                        {% if error %}
                            <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Erreur :</strong> {{ error }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endif %}
                        
                        <form action="index.php?controleur=devoir&methode=creer" method="post" id="formCreer">

                            {# Sélection de la matière #}
                            <div class="mb-3">
                                <label for="idCour" class="form-label small fw-bold">Matière / Ressource</label>
                                <select name="idCour" id="idCour" class="form-select" required>
                                    <option value="" selected disabled>-- Sélectionnez une matière --</option>
                                    {% set currentSemestre = "" %}
                                    {% for cours in lesCours %}
                                        {% if cours.semestre != currentSemestre %}
                                            {% if currentSemestre != "" %}</optgroup>{% endif %}
                                            <optgroup label="Semestre {{ cours.semestre }}">
                                            {% set currentSemestre = cours.semestre %}
                                        {% endif %}
                                        <option value="{{ cours.id }}">{{ cours.libelle }}</option>
                                    {% endfor %}
                                    </optgroup>
                                </select>
                            </div>

                            {# Dates et Heures #}
                            <div class="row g-3">
                                <div class="col-md-3 mb-3">
                                    <label for="date_deb" class="form-label small fw-bold text-primary">Date de début *</label>
                                    <input type="date" class="form-control" id="date_deb" name="date_deb" required>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label for="date_fin" class="form-label small fw-bold text-danger">Date de fin *</label>
                                    <input type="date" class="form-control" id="date_fin" name="date_fin" required>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label for="heure_deb" class="form-label small fw-bold">Heure de début *</label>
                                    <input type="time" class="form-control" id="heure_deb" name="heure_deb" min="8:00" max="18:30" required>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label for="heure_fin" class="form-label small fw-bold">Heure de fin *</label>
                                    <input type="time" class="form-control" id="heure_fin" name="heure_fin" required>
                                </div>
                            </div>

                            {# Description avec Compteur #}
                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <label for="contenu" class="form-label small fw-bold">Consignes / Contenu</label>
                                    <small id="char-count" class="text-muted">0 / 1000</small>
                                </div>
                                <textarea 
                                    class="form-control" 
                                    id="contenu" 
                                    name="contenu" 
                                    rows="4" 
                                    maxlength="1000" 
                                    placeholder="Description du travail à faire..."
                                    required></textarea>
                            </div>

                            {# Couleur de priorité #}
                            <div class="mb-4">
                                <label for="Couleur" class="form-label small fw-bold">Couleur de priorité</label>
                                <input type="color" class="form-control form-control-color w-100" id="Couleur" name="Couleur" 
                                       value="#4e73df" title="Choisir une couleur">
                            </div>

                            <button type="submit" class="btn btn-success w-100 shadow-sm">
                                <i class="bi bi-check-lg"></i> Enregistrer le devoir
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const dDeb = document.getElementById('date_deb');
        const dFin = document.getElementById('date_fin');
        const hDeb = document.getElementById('heure_deb');
        const hFin = document.getElementById('heure_fin');
        const txt = document.getElementById('contenu');
        const cnt = document.getElementById('char-count');
        const form = document.getElementById('formCreer');

        // 1. Initialisation des dates
        const today = new Date().toISOString().split('T')[0];
        dDeb.value = today;
        dFin.value = today;
        dDeb.min = today;
        dFin.min = today;

        // 2. Synchronisation des dates
        dDeb.addEventListener('change', () => {
            dFin.min = dDeb.value;
            if (dFin.value < dDeb.value) {
                dFin.value = dDeb.value;
            }
        });

        // 3. Compteur de caractères
        txt.addEventListener('input', () => {
            const len = txt.value.length;
            cnt.textContent = `${len} / 1000`;
            cnt.classList.toggle('text-danger', len >= 950);
        });

        // 4. VALIDATION UNIQUE AU SUBMIT (Fusionnée)
        form.addEventListener('submit', (e) => {
            const valHD = hDeb.value;
            const valHF = hFin.value;
            const HEURE_MIN = "08:00";
            const HEURE_MAX = "18:30";

            // A. Vérification des bornes Min/Max
            if (valHD < HEURE_MIN || valHD > HEURE_MAX) {
                e.preventDefault();
                alert(`L'heure de début (${valHD}) doit être entre ${HEURE_MIN} et ${HEURE_MAX}`);
                return; // On arrête tout si c'est faux
            }

            if (valHF < HEURE_MIN || valHF > HEURE_MAX) {
                e.preventDefault();
                alert(`L'heure de fin (${valHF}) doit être entre ${HEURE_MIN} et ${HEURE_MAX}`);
                return; // On arrête tout si c'est faux
            }

            // B. Vérification chronologique (Date + Heure)
            const debutFull = new Date(dDeb.value + 'T' + valHD);
            const finFull = new Date(dFin.value + 'T' + valHF);

            if (finFull <= debutFull) {
                e.preventDefault();
                alert("Erreur : La fin doit être strictement après le début !");
            }
        });
    });
</script>
{% endblock %}