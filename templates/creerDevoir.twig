                                <option value="R5.D.04 : Développement pour progiciels">R5.D.04 : Développement pour progiciels</option>
                                <option value="R5.D.04 Développement pour progiciels Partie WordPress">R5.D.04 Développement pour progiciels Partie WordPress</option>
                                <option value="R5.D.05 : Nouveaux paradigmes de base de données">R5.D.05 : Nouveaux paradigmes de base de données</option>
                                <option value="R5.D.06 : Continuité de service">R5.D.06 : Continuité de service</option>
                                <option value="R5.D.07 : Qualité de développement">R5.D.07 : Qualité de développement</option>
                                <option value="R5.D.08 : Cybersécurité">R5.D.08 : Cybersécurité</option>
                                <option value="R5.D.09 : Méthodes d'optimisation pour l'aide à la décision">R5.D.09 : Méthodes d'optimisation pour l'aide à la décision</option>
                                <option value="R5.D.10 : Économie durable et numérique">R5.D.10 : Économie durable et numérique</option>
                                <option value="R5.D.11 : Intégration et performance des systèmes d'information">R5.D.11 : Intégration et performance des systèmes d'information</option>
                                <option value="R5.D.12 : Anglais">R5.D.12 : Anglais</option>
                                <option value="R5.D.15 : Éco-conception logicielle">R5.D.15 : Éco-conception logicielle</option>
