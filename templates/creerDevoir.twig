            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="date_deb" class="form-label">Date de début *</label>
                    <input type="date" class="form-control" id="date_deb" name="date_deb" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="date_fin" class="form-label">Date de fin *</label>
                    <input type="date" class="form-control" id="date_fin" name="date_fin" required>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="heure_deb" class="form-label">Heure de début *</label>
                    <input type="time" class="form-control" id="heure_deb" name="heure_deb" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="heure_fin" class="form-label">Heure de fin *</label>
                    <input type="time" class="form-control" id="heure_fin" name="heure_fin" required>
                </div>
            </div>

            <div class="mb-3">
                <label for="contenu" class="form-label">Consignes / Contenu</label>
                <textarea class="form-control" id="contenu" name="contenu" rows="3" placeholder="Description du travail à faire..." required></textarea>
            </div>

            <div class="mb-3">
                <label for="Couleur" class="form-label">Couleur</label>
                <select class="form-select" id="Couleur" name="Couleur">
                    <option value="Blue">Bleu</option>
                    <option value="purple">violet</option>
                    <option value="Green">Vert</option>
                    <option value="Yellow">Jaune</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success w-100">Enregistrer dans l'agenda</button>
        </form>
    </div>

    <script>
        // Gestion de la date par défaut (aujourd'hui)
        const dateDeb = document.getElementById('date_deb');
        const dateFin = document.getElementById('date_fin');
        const today = new Date().toISOString().split('T')[0];
        
        dateDeb.value = today;
        dateFin.value = today;

        // Si on change la date de début, cela met à jour la date de fin automatiquement
        dateDeb.addEventListener('change', () => {
            dateFin.value = dateDeb.value;
        });
    </script>
{% endblock %}